                                    "tensorboard",
                                    "codecarbon",
                                    "none"
                                ],
                                "type": "string"
                            },
                            "type": "array"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "default": [
                        "none"
                    ],
                    "description": "List of callbacks to report to. If None, no callbacks will be used",
                    "title": "Report To"
                },
                "log_interval_time": {
                    "default": 0.1,
                    "description": "Sampling interval for the system monitor in seconds for Wandb logger.",
